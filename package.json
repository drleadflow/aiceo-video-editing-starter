{
  "name": "aiceo-video-editing-starter",
  "version": "2.0.0",
  "private": true,
  "description": "A practical Codex and HyperFrames video editing starter",
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "check": "hyperframes check",
    "preview": "hyperframes preview examples/demo",
    "render": "node scripts/render.mjs",
    "scan": "node scripts/python.mjs scripts/release_scan.py",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:renderer": "hyperframes doctor",
    "sync:skills": "node scripts/sync-skills.mjs",
    "new-video": "node scripts/new-video.mjs",
    "import-asset": "node scripts/import-asset.mjs",
    "cut": "node scripts/python.mjs scripts/cut.py",
    "test": "node --test tests/*.test.mjs",
    "demo:check": "hyperframes check examples/demo",
    "transcribe": "node scripts/transcribe-elevenlabs.mjs",
    "test:media": "node scripts/smoke-media.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.8.31"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
